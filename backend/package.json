{
  "name": "catalogo-favoritos-api",
  "version": "1.0.0",
  "description": "API REST de catálogo de productos con favoritos, JWT y roles (Node.js + Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/initDb.js",
    "db:reset": "node scripts/initDb.js --reset",
    "admin:crear": "node scripts/crearAdmin.js",
    "test:postman": "newman run postman/catalogo.postman_collection.json -e postman/local.postman_environment.json --export-environment postman/local.postman_environment.json",
    "test:persistencia": "newman run postman/catalogo.postman_collection.json -e postman/local.postman_environment.json --folder \"10 - Persistencia (ejecutar tras reiniciar)\"",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
